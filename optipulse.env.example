# Contoh konfigurasi OptiPulse NOC untuk aplikasi .exe.
# Salin file ini menjadi "optipulse.env" di folder yang sama dengan
# OptiPulse-NOC.exe (atau di %LOCALAPPDATA%\OptiPulse NOC\).
# File optipulse.env tidak ikut di-commit karena berisi password.

# --- OLT ---
OLT_DEVICE_TYPE=zte_zxros
OLT_HOST=192.168.1.100
OLT_USERNAME=admin
OLT_PASSWORD=password_olt
OLT_PORT=23
OLT_TIMEOUT=10
OLT_COMMAND=show gpon onu detail-info gpon-olt_1/1/1

# --- Aplikasi ---
PORT=5000
HOST=0.0.0.0
# Buka browser otomatis saat .exe dijalankan (1 = ya, 0 = tidak)
# OPTIPULSE_OPEN_BROWSER=1
